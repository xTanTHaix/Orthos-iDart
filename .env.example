# ==============================================================================
# Orthos-iDart Environment Configuration Example
# Copy this file to .env and configure as needed for your environment.
# ==============================================================================

# Runtime Environment (development | testing | production)
ORTHOS_ENV=development

# Logging Configuration (DEBUG | INFO | WARNING | ERROR | CRITICAL)
ORTHOS_LOG_LEVEL=INFO

# Storage Backend (fallback | tpx)
# - fallback: 100% pure Python memory storage (default, zero-dependency)
# - tpx: Hardware-accelerated kernel-bypass storage via io_uring (requires C extensions)
ORTHOS_STORAGE_BACKEND=fallback

# Memory Storage Limits (in bytes)
# 104857600 = 100 MB
ORTHOS_MEMORY_LIMIT=104857600

# Annihilator Mathematical Optimizer Limits
ORTHOS_MAX_RECURRENCE_ORDER=50
ORTHOS_FAULHABER_MAX_DEGREE=20
ORTHOS_SIMPLEX_MAX_ITERATIONS=1000

# Complexity Gate Limits
ORTHOS_MAX_CYCLOMATIC_COMPLEXITY=10
ORTHOS_MAX_MCCABE_COMPLEXITY=10

# Verification & Optimization Cache
ORTHOS_CACHE_ENABLED=true
ORTHOS_CACHE_MAX_ENTRIES=1000
ORTHOS_CACHE_TTL_SECONDS=300
